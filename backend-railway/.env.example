# AgriVision Backend Environment Variables
# Copy to .env and fill in your values

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://postgres:password@localhost:5432/agrivision

# Authentication
SECRET_KEY=your-secret-key-change-this-in-production

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MQTT (Hub Communication)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# S3 Image Storage (use Cloudflare R2 or AWS S3)
S3_BUCKET=agrivision-images
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (info@theagrivision.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@theagrivision.com
SMTP_PASSWORD=

# Google Maps API (for farm configurator)
GOOGLE_MAPS_API_KEY=
